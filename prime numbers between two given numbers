#include <stdio.h>
  int main (){
    int a,b;
    printf("Enter the starting number: ");
    scanf("%d",&a);
    printf("Enter the ending number: ");
    scanf("%d",&b);

    printf("The prime number between %d and %d are: ",a,b);

    for(int i=a;i<=b;i++){
     
         int p=1;
          if (i<=1){
            continue;
           }
 
        for(int j=2;j<i;j++){
            if(i%j==0){
               p=0;
                break;
              }
         }

        if(p){
            printf("%d ",i);
          }
     }
    return 0;
  }
