#include <stdio.h>
  int main (){
    int n;
    printf("Check weather your enterd number is prime \nEnter the number: ");
    scanf("%d",&n);

    int p=1;

    if(n<=1){
    p=0;
    }
    else{
          for(int i=2;i<n;i++){
            if(n%i==0){
                p=0;
                break;
            }
          }

    }
    if(p){
        printf("%d is a prime number ",n);
    }
    else {
        printf("%d is not a prime number ",n);
    }
    return 0;
  }
